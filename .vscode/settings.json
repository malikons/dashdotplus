{
  "search.exclude": {
    "**/.yarn": true,
    "**/.pnp.*": true
  },
  "biome.enabled": true,
  "cSpell.words": ["dashdot", "dashdotplus", "mdx"],
  "editor.codeActionsOnSave": {
    "source.fixAll.biome": "explicit",
    "source.biome": "explicit",
    "source.organizeImports.biome": "explicit"
  }
}
